# Cairn environment variables — copy to `.env.local` (git-ignored) and fill in your own values.
# Every VITE_* value is embedded in the JavaScript bundle at build time, so it is PUBLIC.
#
# NEVER put the Supabase service_role key or a secret key (sb_secret_…) in any of these
# variables: it bypasses Row Level Security and would expose every user's data. The frontend
# only ever uses the publishable (or legacy anon) key; the app refuses to run with a secret key.

# Supabase project URL: Dashboard → Project Settings → Data API (https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_…): Dashboard → Project Settings → API Keys.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy anon JWT key — used only when VITE_SUPABASE_PUBLISHABLE_KEY is empty.
# Supabase is retiring the legacy keys; prefer the publishable key.
VITE_SUPABASE_ANON_KEY=

# Data mode. Leave empty for automatic selection: cloud sync (Supabase) when the URL and a key are
# set, otherwise local mode (data stays in this browser's localStorage, no sign-in, shown as
# "Local only — not synced"). Set to `local` to force local mode even when keys are present.
VITE_DATA_MODE=
