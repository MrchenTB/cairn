# Cairn staging test settings. Copy to `.env.staging.local` (git-ignored) and fill in your own values.
# Used by `npm run dev:staging`, `npm run build:staging` and `npm run test:staging`.
# Every VITE_* value is embedded in the JavaScript bundle, so it is PUBLIC.
#
# NEVER put a service_role key or a secret key (sb_secret_...) in this file, in any variable.
# The tests run as ordinary signed-in users on purpose, and they refuse to start if any VITE_* or
# CAIRN_* variable holds such a key.

# Project URL of the STAGING project only: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Publishable key of the staging project (sb_publishable_...).
VITE_SUPABASE_PUBLISHABLE_KEY=

# Leave both empty: the app and the tests use the publishable key and pick cloud mode by themselves.
VITE_SUPABASE_ANON_KEY=
VITE_DATA_MODE=

# Project ref of the staging project (the <project-ref> part of the URL above). The tests refuse to
# run when it does not match VITE_SUPABASE_URL.
CAIRN_STAGING_PROJECT_REF=

# Optional but recommended: the project ref of PRODUCTION. When set, the tests refuse to run if
# the URL or the staging ref is that project.
CAIRN_PRODUCTION_PROJECT_REF=

# Two test accounts that exist ONLY in the staging project and hold ONLY test data. The tests stop if
# either account contains a project that was not created by them (name not starting with "[e2e] ").
CAIRN_STAGING_USER_A_EMAIL=
CAIRN_STAGING_USER_A_PASSWORD=
CAIRN_STAGING_USER_B_EMAIL=
CAIRN_STAGING_USER_B_PASSWORD=
