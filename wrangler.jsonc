// Cloudflare Workers Static Assets (no Worker script): serves the Vite build in ./dist.
// Deploy: `npm run build` then `npx wrangler@4.156.1 deploy --env=""` (see docs/deployment.md).
{
  "name": "cairn",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  // Staging site: `npm run build:staging` then `npx wrangler@4.156.1 deploy --env staging`.
  "env": {
    "staging": {
      "name": "cairn-staging",
      "assets": {
        "directory": "./dist-staging",
        "not_found_handling": "single-page-application",
      },
    },
  },
}
